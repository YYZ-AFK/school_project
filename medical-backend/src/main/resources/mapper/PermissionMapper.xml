<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qst.medical.mapper.PermissionMapper">
    <resultMap id="PermissionModelMap" type="com.qst.medical.model.PermissionModel">
        <id column="id" property="id"/>
        <result column="pid" property="pid"/>
        <result column="name" property="name"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="level" property="level"/>
        <result column="title" property="title"/>
    </resultMap>

    <select id="listByRole" resultMap="PermissionModelMap">
        select p.id, p.pid, p.name, p.path, p.component, p.level, p.title
        from permission p
        inner join role_permission rp on p.id = rp.per_id
        where rp.roleName = #{roleName}
        order by p.level asc, p.id asc
    </select>
</mapper>
